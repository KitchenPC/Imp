<Project Sdk="Microsoft.NET.Sdk">
   <PropertyGroup>
      <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
      <PackageId>KitchenPC.Imp</PackageId>
      <Version>0.2.0</Version>
      <Title>Imp</Title>
      <Authors>KitchenPC</Authors>
      <Company>KitchenPC</Company>
      <Description>A lightweight ASP.NET Core page framework that compiles embedded templates and serves them from memory.</Description>
      <PackageTags>aspnetcore;middleware;web;templates;in-memory</PackageTags>
      <PackageProjectUrl>https://github.com/KitchenPC/Imp</PackageProjectUrl>
      <RepositoryUrl>https://github.com/KitchenPC/Imp.git</RepositoryUrl>
      <RepositoryType>git</RepositoryType>
      <PackageLicenseExpression>MIT</PackageLicenseExpression>
      <PackageReadmeFile>README.md</PackageReadmeFile>
      <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
      <PublishRepositoryUrl>true</PublishRepositoryUrl>
      <EmbedUntrackedSources>true</EmbedUntrackedSources>
      <IncludeSymbols>true</IncludeSymbols>
      <SymbolPackageFormat>snupkg</SymbolPackageFormat>
      <GenerateDocumentationFile>true</GenerateDocumentationFile>
      <NoWarn>$(NoWarn);1591</NoWarn>
   </PropertyGroup>

   <ItemGroup>
      <FrameworkReference Include="Microsoft.AspNetCore.App" />
   </ItemGroup>

   <ItemGroup>
      <InternalsVisibleTo Include="Imp.Tests" />
      <None Include="../../LICENSE" Pack="true" PackagePath="/" />
      <None Include="../../README.md" Pack="true" PackagePath="/" />
   </ItemGroup>
</Project>
